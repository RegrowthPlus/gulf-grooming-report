---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SchemaMarkup from '../components/SchemaMarkup.astro';
import { siteConfig } from '../../site.config';
import authors from '../data/authors.json';
---

<BaseLayout title="About Us" description={`Learn about ${siteConfig.name}, our mission, and the team behind our evidence-based health content.`}>
  <Fragment slot="head">
    <SchemaMarkup type="Organization" data={{}} />
  </Fragment>

  <Header />

  <main class="static-page">
    <div class="container">
      <Breadcrumbs items={[{ name: 'About Us' }]} />

      <h1>About {siteConfig.name}</h1>

      <section class="page-section">
        <h2>Why We Exist</h2>
        <p>Gulf Grooming Report started with a simple observation: most men's grooming advice doesn't work here. Products rated highly by magazines in London or New York underperform in Gulf conditions. Hair loss accelerates in ways nobody warned you about. And the internet is full of generic advice that ignores the environmental factors making your situation different.</p>
        <p>We built this site to fill that gap. Every article, every product test, and every recommendation on GGR is created for men living in hard water, extreme heat, and the specific conditions of the Gulf region.</p>
      </section>

      <section class="page-section">
        <h2>How We Work</h2>
        <ul>
          <li><strong>We test everything</strong> - Products are tested in Gulf water and Gulf heat, not in a lab somewhere in Europe. If we recommend it, we've used it.</li>
          <li><strong>We cite our sources</strong> - Clinical claims are backed by peer-reviewed research. We link to the studies so you can read them yourself.</li>
          <li><strong>No affiliate pressure</strong> - Our editorial team decides what to cover and what to recommend. Business relationships don't enter that process.</li>
          <li><strong>Gulf-specific context</strong> - Every article accounts for hard water, humidity, vitamin D factors, and the other environmental realities of living in this region.</li>
        </ul>
      </section>

      <section class="page-section">
        <h2>Our Team</h2>
        <div class="team-grid">
          {Object.values(authors).map((author: any) => (
            <div class="team-member">
              <img src={author.photo} alt={author.name} width="80" height="80" class="team-photo" loading="lazy" />
              <div class="team-info">
                <h3><a href={`/authors/${author.slug}/`}>{author.name}</a></h3>
                <p class="team-title">{author.title}</p>
                <p class="team-credentials">{author.credentials}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="page-section">
        <h2>Contact Us</h2>
        <p>Have a question, correction, or product you think we should test? We read everything. Reach out to our editorial team at <strong>editorial@gulfgrooming.com</strong>.</p>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .static-page {
    padding: var(--space-xl) 0 var(--space-3xl);
  }

  h1 {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    margin-bottom: var(--space-xl);
  }

  .page-section {
    margin-bottom: var(--space-2xl);
    max-width: 700px;
  }

  .page-section h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    margin-bottom: var(--space-md);
  }

  .page-section p,
  .page-section li {
    color: var(--color-text);
    line-height: 1.7;
  }

  .page-section ul {
    padding-left: 1.5em;
    margin-bottom: 1.5em;
  }

  .page-section li {
    margin-bottom: 0.75em;
  }

  .team-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .team-member {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .team-photo {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .team-info h3 {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    font-weight: 700;
    margin: 0 0 var(--space-xs);
  }

  .team-info h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .team-info h3 a:hover {
    color: var(--color-primary);
  }

  .team-title {
    font-size: 0.875rem;
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .team-credentials {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (min-width: 1025px) {
    h1 {
      font-size: 2.5rem;
    }
  }
</style>
