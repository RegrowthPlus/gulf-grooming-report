---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { siteConfig } from '../../site.config';
---

<BaseLayout title="Editorial Standards" description={`How ${siteConfig.name} ensures accuracy, independence, and transparency in every article.`}>
  <Header />

  <main class="static-page">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Editorial Standards' }]} />

      <h1>Editorial Standards</h1>

      <section class="page-section">
        <h2>Our Editorial Process</h2>
        <p>Every article on {siteConfig.name} goes through the same process. No shortcuts.</p>
        <ol>
          <li><strong>Research</strong> - Writers review the latest clinical literature, product specifications, and expert sources before writing begins.</li>
          <li><strong>Testing</strong> - Product reviews involve hands-on testing in Gulf conditions. We use the products ourselves before recommending them.</li>
          <li><strong>Writing</strong> - Articles are written in direct, accessible language. We give clear verdicts and explain our reasoning.</li>
          <li><strong>Fact-checking</strong> - All clinical claims are verified against primary sources. Study references include dates and sample sizes where available.</li>
          <li><strong>Editorial review</strong> - Every article is reviewed by a senior editor for accuracy, tone, and completeness before publication.</li>
        </ol>
      </section>

      <section class="page-section">
        <h2>Product Testing Standards</h2>
        <p>When we say we've tested a product, we mean it. Our testing process involves:</p>
        <ul>
          <li>Products purchased at retail price, never sent free by brands</li>
          <li>Minimum four-week testing period in Gulf water and climate conditions</li>
          <li>Consistent evaluation criteria across all products in a category</li>
          <li>Clear disclosure of testing methodology in every review article</li>
        </ul>
        <p>For our full testing methodology, see our <a href="/how-we-test/">How We Test</a> page.</p>
      </section>

      <section class="page-section">
        <h2>Editorial Independence</h2>
        <p>Our editorial team operates independently from our business relationships. Advertisers and affiliate partners have no influence over:</p>
        <ul>
          <li>Which topics we cover</li>
          <li>What conclusions our articles reach</li>
          <li>Which products or treatments we recommend</li>
          <li>The content of our reviews or comparisons</li>
        </ul>
      </section>

      <section class="page-section">
        <h2>Corrections Policy</h2>
        <p>We take accuracy seriously. If an error is identified in a published article, we will:</p>
        <ul>
          <li>Correct the error promptly</li>
          <li>Note the correction at the bottom of the article with the date and nature of the change</li>
          <li>Update the "last updated" date</li>
        </ul>
        <p>To report an error, contact us at <strong>corrections@gulfgrooming.com</strong>.</p>
      </section>

      <section class="page-section">
        <h2>Content Updates</h2>
        <p>Health information evolves as new research is published. We periodically review and update our articles to reflect the latest evidence. Updated articles display a "last updated" date alongside the original publication date.</p>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .static-page {
    padding: var(--space-xl) 0 var(--space-3xl);
  }

  h1 {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    margin-bottom: var(--space-xl);
  }

  .page-section {
    margin-bottom: var(--space-2xl);
    max-width: 700px;
  }

  .page-section h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    margin-bottom: var(--space-md);
  }

  .page-section p,
  .page-section li {
    color: var(--color-text);
    line-height: 1.7;
  }

  .page-section ul,
  .page-section ol {
    padding-left: 1.5em;
    margin-bottom: 1.5em;
  }

  .page-section li {
    margin-bottom: 0.5em;
  }

  @media (min-width: 1025px) {
    h1 {
      font-size: 2.5rem;
    }
  }
</style>
